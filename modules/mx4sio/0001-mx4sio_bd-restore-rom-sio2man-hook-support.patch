 int sio2man_hook_init()
 {
+    iop_sema_t sema;
+
     M_DEBUG("%s\n", __FUNCTION__);
 
+    // Semaphores for the legacy (ROM sio2man) hook model: lock_sema is held by
+    // a client from transfer_init to transfer_reset, lock_sema2 only around the
+    // transfer itself. sio2man_hook_sio2_lock() takes both (in this order) to
+    // get the bus exclusively.
+    sema.attr    = 1;
+    sema.initial = 1;
+    sema.max     = 1;
+    sema.option  = 0;
+    g_legacy_lock_sema  = CreateSema(&sema);
+    g_legacy_lock_sema2 = CreateSema(&sema);
+
 #if SIO2MAN_HOOK_SUPPORT_SET_INTR_HANDLER
     {
         intrman_internals_t *intrman_internals;
@@ -280,6 +465,17 @@ void sio2man_hook_deinit()
         }
     }
 
+    // Unhook a legacy-hooked 'sio2man' (ROM library)
+    _sio2man_legacy_unhook();
+    if (g_legacy_lock_sema >= 0) {
+        DeleteSema(g_legacy_lock_sema);
+        g_legacy_lock_sema = -1;
+    }
+    if (g_legacy_lock_sema2 >= 0) {
+        DeleteSema(g_legacy_lock_sema2);
+        g_legacy_lock_sema2 = -1;
+    }
+
     unhook_loadcore();
 #if SIO2MAN_HOOK_SUPPORT_SET_INTR_HANDLER
     unhook_intrman();
@@ -289,15 +485,31 @@ void sio2man_hook_deinit()
 void sio2man_hook_sio2_lock()
 {
     // Lock sio2man driver so we can use it exclusively
-    if (g_hook_data[1].m_23_psio2_pad_transfer_init)
+    if (g_legacy_hook.m_lib) {
+        // Legacy model: our own semaphores wrap every sio2man entry point
+        WaitSema(g_legacy_lock_sema);
+        WaitSema(g_legacy_lock_sema2);
+    } else if (g_hook_data[1].m_23_psio2_pad_transfer_init) {
         g_hook_data[1].m_23_psio2_pad_transfer_init();
+    } else if (g_hook_data[0].m_23_psio2_pad_transfer_init) {
+        // Only a v1.x library is resident: lock through it (upstream left this
+        // as a silent no-op, i.e. no arbitration at all on v1.x-only systems)
+        g_hook_data[0].m_23_psio2_pad_transfer_init();
+    }
 }
 
 void sio2man_hook_sio2_unlock()
 {
     // Unlock sio2man driver
-    if (g_hook_data[1].m_26_psio2_transfer_reset)
+    if (g_legacy_hook.m_lib) {
+        // Legacy model: release in reverse order
+        SignalSema(g_legacy_lock_sema2);
+        SignalSema(g_legacy_lock_sema);
+    } else if (g_hook_data[1].m_26_psio2_transfer_reset) {
         g_hook_data[1].m_26_psio2_transfer_reset();
+    } else if (g_hook_data[0].m_26_psio2_transfer_reset) {
+        g_hook_data[0].m_26_psio2_transfer_reset();
+    }
 }
 
