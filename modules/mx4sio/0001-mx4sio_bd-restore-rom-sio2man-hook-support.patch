+void *ioplib_hookExportEntry(iop_library_t *lib, unsigned int entry, void *func)
+{
+    int oldstate;
+    void *oldfunc;
+
+    if (entry >= ioplib_getTableSize(lib))
+        return NULL;
+
+    CpuSuspendIntr(&oldstate);
+    oldfunc = lib->exports[entry];
+    lib->exports[entry] = func;
+    CpuResumeIntr(oldstate);
+
+    return oldfunc;
+}
