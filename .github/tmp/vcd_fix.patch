diff --git a/src/vcdsupport.c b/src/vcdsupport.c
--- a/src/vcdsupport.c
+++ b/src/vcdsupport.c
@@ -1517,30 +1517,76 @@ static int vcdBdmaManualPairPresent(void)
-// 1.0.1-style fast path for the launch equip: a card with NO marker but BOTH driver modules present is
-// a pair the user (or an install predating the marker file) manages MANUALLY. vcdReadBdmaMode()
-// collapses "marker absent" into VCD_BDMA_FAT32, so before this check every launch on such a card read
-// as a MISMATCH and paid the FULL equip -- source-device module loads with bounded waits plus two module
-// copies onto the memory card -- on EVERY VCD launch (NathanNeurotic: "unnecessary over work... extended
-// wait on game launch... unnecessary MC transfer"). Trust the card and hand off. An EXPLICIT different
-// marker (a real variant switch, checked by the caller before this) or a missing/partial pair still does
-// the copy work -- ONCE -- after which the marker matches and every later launch takes the cheap path.
-static int vcdBdmaManualPairPresent(void)
+static int vcdBdmaModuleSize(const char *path)
 {
-    char mcDir[64];
-    char path[96];
-    int fd, i;
-
-    if (!vcdResolvePopstarterMc(mcDir, sizeof(mcDir)))
-        return 0;
-    snprintf(path, sizeof(path), "%s/%s", mcDir, VCD_BDMA_MARKER);
-    fd = open(path, O_RDONLY);
-    if (fd >= 0) {
-        close(fd);
-        return 0; // marker PRESENT -> its verdict stands (the caller already compared it)
-    }
-    for (i = 0; i < 2; i++) {
-        snprintf(path, sizeof(path), "%s/%s", mcDir, vcdBdmaModule[i]);
-        fd = open(path, O_RDONLY);
-        if (fd < 0)
-            return 0; // pair incomplete -> a real equip is useful work
-        close(fd);
-    }
-    return 1;
+    struct stat st;
+    if (path == NULL || stat(path, &st) != 0 || st.st_size <= 0)
+        return -1;
+    return (int)st.st_size;
+}
+
+// The marker is only a cache of the equipped mode. A stale marker or an unmarked pair can leave
+// POPSTARTER with the wrong BDMA files, so the cheap on-card size check is the launch-time authority.
+// The known pair sizes are the canonical embedded BDMA module sizes: USB and MX4SIO share usbd.irx,
+// while their usbhdfsd.irx sizes distinguish the two families.
+static int vcdBdmaPairMatchesMode(int mode)
+{
+    char mcDir[64], path[96];
+    int usbdSize, hdfsdSize, expectedUsbd, expectedHdfsd;
+
+    if (!vcdResolvePopstarterMc(mcDir, sizeof(mcDir)))
+        return 0;
+
+    snprintf(path, sizeof(path), "%s/%s", mcDir, vcdBdmaModule[0]);
+    usbdSize = vcdBdmaModuleSize(path);
+    snprintf(path, sizeof(path), "%s/%s", mcDir, vcdBdmaModule[1]);
+    hdfsdSize = vcdBdmaModuleSize(path);
+
+    if (mode == VCD_BDMA_FAT32)
+        return usbdSize < 0 && hdfsdSize < 0;
+
+    switch (mode) {
+        case VCD_BDMA_USBEXFAT:
+            expectedUsbd = 48500;
+            expectedHdfsd = 34508;
+            break;
+        case VCD_BDMA_MX4SIO:
+            expectedUsbd = 48500;
+            expectedHdfsd = 14993;
+            break;
+        case VCD_BDMA_MMCE:
+            expectedUsbd = 11841;
+            expectedHdfsd = 19733;
+            break;
+        case VCD_BDMA_ATA:
+            expectedUsbd = 42749;
+            expectedHdfsd = 21837;
+            break;
+        default:
+            return 0;
+    }
+
+    return vcdReadBdmaMode() == mode && usbdSize == expectedUsbd && hdfsdSize == expectedHdfsd;
+}
+
+// A markerless legacy/manual installation is acceptable only when its actual module pair matches
+// the requested launch family. A different pair is stale environment, not an instruction to skip
+// preparation.
+static int vcdBdmaManualPairMatches(int mode)
+{
+    char mcDir[64], markerPath[96], path[96];
+    int fd, usbdSize, hdfsdSize;
+
+    if (!vcdResolvePopstarterMc(mcDir, sizeof(mcDir)))
+        return 0;
+    snprintf(markerPath, sizeof(markerPath), "%s/%s", mcDir, VCD_BDMA_MARKER);
+    fd = open(markerPath, O_RDONLY);
+    if (fd >= 0) {
+        close(fd);
+        return 0;
+    }
+    snprintf(path, sizeof(path), "%s/%s", mcDir, vcdBdmaModule[0]);
+    usbdSize = vcdBdmaModuleSize(path);
+    snprintf(path, sizeof(path), "%s/%s", mcDir, vcdBdmaModule[1]);
+    hdfsdSize = vcdBdmaModuleSize(path);
+
+    switch (mode) {
+        case VCD_BDMA_FAT32:
+            return usbdSize < 0 && hdfsdSize < 0;
+        case VCD_BDMA_USBEXFAT:
+            return usbdSize == 48500 && hdfsdSize == 34508;
+        case VCD_BDMA_MX4SIO:
+            return usbdSize == 48500 && hdfsdSize == 14993;
+        case VCD_BDMA_MMCE:
+            return usbdSize == 11841 && hdfsdSize == 19733;
+        case VCD_BDMA_ATA:
+            return usbdSize == 42749 && hdfsdSize == 21837;
+        default:
+            return 0;
+    }
 }
